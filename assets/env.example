# beautiful-motion: keys, filled only when a step needs them. The project's .env starts as a copy of this file (only if it
# does not exist yet). Never commit .env (add it to .gitignore). Fill only the lines you need; leave the rest empty.
# Edit it in a text editor and save as UTF-8.

# Generated images (plates, textures): the agent asks which provider you want
# Higgsfield issues a key and a secret (its SDK also accepts one HF_KEY="key:secret")
HF_API_KEY=
HF_API_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

# Voiceover, music and sound effects (ElevenLabs). Higgsfield's voice or music through its API uses the HF_ keys above;
# Higgsfield's app and Suno need no key: the user hands over the file.
ELEVENLABS_API_KEY=

# Sound effects from the Freesound library (an API token)
FREESOUND_API_KEY=
